# Google AI Studio API key for natural-language search (/api/parse).
# Get one at https://aistudio.google.com/apikey
#
# On the free tier Google uses prompts and responses to improve its products,
# and there is a hard rate limit (20 requests/minute). Without this key the site
# still works fully — the NL box disables itself and the manual filters take over.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.7-flash.
# GEMINI_MODEL=gemini-3.7-flash

# Optional. Defaults to ./data/statline.db
# STATLINE_DB_PATH=/data/statline.db

# Required only for the nightly ingest route (POST /api/ingest).
# STATLINE_INGEST_SECRET=
